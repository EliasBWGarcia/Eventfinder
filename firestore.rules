rules_version = '2';

// Production mode: alt er lukket, indtil vi bevidst åbner for noget.
// Når favoritter/login kommer, åbnes kun for den indloggede brugers egne data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
